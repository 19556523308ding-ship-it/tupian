---
interface Props {
	width?: number;
	height?: number;
}
const { width, height } = Astro.props;
---

<svg width={width} height={height} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- 方案 B：叠帧动效流 (Frame Sequence) -->
    <!-- 底层帧：斜向深紫背板 -->
    <rect x="7" y="14" width="28" height="36" rx="8" fill="#4F46E5" fill-opacity="0.35" transform="rotate(-12 21 32)" />
    <!-- 中间关键帧：科技靛蓝 -->
    <rect x="17" y="13" width="28" height="38" rx="8" fill="#6366F1" fill-opacity="0.75" />
    <!-- 顶层主视帧：高光极光紫带渐变投影 -->
    <rect x="25" y="11" width="31" height="42" rx="9" fill="url(#logo_grad_b)" />
    <!-- 播放与动态核心三角 -->
    <path d="M37 25.5L48 32L37 38.5V25.5Z" fill="#FFFFFF" />
    <defs>
        <linearGradient id="logo_grad_b" x1="25" y1="11" x2="56" y2="53" gradientUnits="userSpaceOnUse">
            <stop stop-color="#7C3AED" />
            <stop offset="1" stop-color="#4F46E5" />
        </linearGradient>
    </defs>
</svg>
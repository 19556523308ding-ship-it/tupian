---
import BrowserIcon from '@components/BrowserIcon.astro';
import EditBox from '@components/EditBox.jsx';
import Privacy from '@components/Privacy.astro';
import fakeact from '@static/fakeact.svg';
import fakemail from '@static/fakemail.svg';
import { getLang, getLocale, getBrowserType } from '@i18n/index';
import { getRelativeLocaleUrl } from '@lib/localePaths';

const { locale } = Astro.params;
const l = getLang(locale);
const lang = getLocale(locale);
const t = l.editor;

const extLink = {
    'Edge': 'https://microsoftedge.microsoft.com/addons/detail/kncmnbknmjfaejmkcogljhkehippifho',
    'Firefox': 'https://addons.mozilla.org/zh-CN/firefox/addon/shoteasy/',
    'Chrome': 'https://chromewebstore.google.com/detail/nmppkehciohcgcehlnifgeokgioidknh'
} as {[key: string]: string};

const browserType = getBrowserType(Astro.request?.headers?.get('User-Agent'));
const videoConvertUrl = getRelativeLocaleUrl(lang, '/video-convert');
---

<div class="container py-8 relative z-10 flex-1">
    <!-- 顶部主打功能通知横幅（突出视频转 GIF 核心亮点） -->
    <div class="mb-6 flex justify-center">
        <a
            href={videoConvertUrl}
            class="group inline-flex items-center gap-2 rounded-full border border-indigo-200/80 bg-gradient-to-r from-indigo-50/90 via-purple-50/90 to-violet-50/90 px-4 py-1.5 text-xs font-semibold text-indigo-700 shadow-sm transition-all hover:border-indigo-300 hover:shadow-brand hover:scale-[1.02]"
        >
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-indigo-600 text-[11px] text-white">🎬</span>
            <span>{lang === 'zh-CN' ? '全新主打：视频转 GIF 动图制作器，本地秒级处理' : 'Featured: Fast Video to GIF Maker with Local Processing'}</span>
            <span class="font-bold text-indigo-600 group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
    </div>

    <!-- Hero 标题（融合 Filerobot 经典优雅深海蓝与质感薄荷青绿） -->
    <h1 class="text-4xl text-center leading-[42px] font-extrabold mb-2 bg-gradient-to-r from-slate-900 via-indigo-600 to-teal-500 bg-clip-text text-transparent">
        {t.feature}
    </h1>
    <p class="text-center text-slate-600">
        <span>{t.noSign}</span><span>{t.online} </span><span class="font-extrabold bg-gradient-to-r from-indigo-600 to-teal-500 bg-clip-text text-transparent">{t.free} ✨</span>
    </p>

    <!-- 浏览器插件 / 快速行动 -->
    <div class="flex flex-col items-center gap-1 justify-center pt-3 pb-3">
        <a
            href={extLink[browserType] || extLink.Chrome}
            title={t.extension}
            target="_blank"
            rel="noopener noreferrer"
            class="py-2.5 px-5 flex gap-2 items-center rounded-full text-sm mt-3 mb-2 bg-slate-900 text-white select-none hover:bg-indigo-600 transition-colors shadow-sm"
        >
            <BrowserIcon type={browserType} width={18} height={18} />
            <span>{t.extension}</span>
        </a>
        <p class="text-xs opacity-75 text-center">{t.capture}</p>
        <p class="text-xs opacity-75">{t.instantly}</p>
    </div>

    <!-- 工具快捷胶囊栏（视频转 GIF 居首并带有高亮效果） -->
    <div class="flex flex-col gap-2.5 justify-center text-xs md:flex-row md:flex-wrap my-4">
        <div class="text-center">
            <a
                href={videoConvertUrl}
                title={l.nav.videoConvert.title}
                class="py-1.5 px-3.5 inline-flex items-center gap-1.5 rounded-full font-bold text-white bg-gradient-to-r from-indigo-600 to-purple-600 shadow-brand hover:shadow-brand-lg hover:scale-[1.03] transition-all"
            >
                🎬 {l.nav.videoConvert.name}
            </a>
        </div>
        <div class="text-center">
            <a
                href={getRelativeLocaleUrl(lang, '/take-a-screenshot')}
                title={l.nav.screenshot.title}
                class="py-1.5 px-3.5 inline-block rounded-full bg-white text-indigo-600 border border-indigo-200 shadow-sm transition-all hover:bg-indigo-50 hover:border-indigo-300"
            >
                📸 {l.nav.screenshot.name}
            </a>
        </div>
        <div class="text-center">
            <a
                href={getRelativeLocaleUrl(lang, '/screenshot-beautifier')}
                title={l.nav.beautifier.title}
                class="py-1.5 px-3.5 inline-block rounded-full bg-white text-indigo-600 border border-indigo-200 shadow-sm transition-all hover:bg-indigo-50 hover:border-indigo-300"
            >
                🏞️ {l.nav.beautifier.name}
            </a>
        </div>
        <div class="text-center">
            <a
                href={getRelativeLocaleUrl(lang, '/image-compressor')}
                title={l.nav.compressor.title}
                class="py-1.5 px-3.5 inline-block rounded-full bg-white text-indigo-600 border border-indigo-200 shadow-sm transition-all hover:bg-indigo-50 hover:border-indigo-300"
            >
                ⬇️ {l.nav.compressor.name}
            </a>
        </div>
        <div class="text-center">
            <a
                href={getRelativeLocaleUrl(lang, '/convert')}
                title={l.nav.convert.title}
                class="py-1.5 px-3.5 inline-block rounded-full bg-white text-indigo-600 border border-indigo-200 shadow-sm transition-all hover:bg-indigo-50 hover:border-indigo-300"
            >
                🔁 {l.nav.convert.name}
            </a>
        </div>
        <div class="text-center">
            <a
                href={getRelativeLocaleUrl(lang, '/long-image')}
                title={l.nav.longImage.title}
                class="py-1.5 px-3.5 inline-block rounded-full bg-white text-indigo-600 border border-indigo-200 shadow-sm transition-all hover:bg-indigo-50 hover:border-indigo-300"
            >
                🧩 {l.nav.longImage.name}
            </a>
        </div>
    </div>

    <!-- 核心在线照片编辑器工作台 -->
    <div class="pt-4 pb-12 min-h-[716px]">
        <EditBox client:only="react" />
    </div>

    <!-- 特色说明模块 -->
    <section id="how-to-edit" class="pt-4 pb-8">
        <h2 class="text-xl font-extrabold mb-4 text-center text-slate-800">{t.how}</h2>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 mb-3">
            <div class="rounded-xl bg-indigo-50/60 p-4 border border-indigo-100 transition-all hover:shadow-sm">
                <div class="mb-1 text-center text-xl">📸</div>
                <h3 class="text-sm font-bold mb-1 text-center text-indigo-700">{t.take}</h3>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed text-center">{t.use}</p>
            </div>
            <div class="rounded-xl bg-violet-50/60 p-4 border border-violet-100 transition-all hover:shadow-sm">
                <div class="mb-1 text-center text-xl">🪄</div>
                <h3 class="text-sm font-bold mb-1 text-center text-violet-700">{t.more}</h3>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed text-center">{t.moreUse}</p>
            </div>
        </div>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-3 mb-3">
            <div class="rounded-xl bg-cyan-50/60 p-4 border border-cyan-100 transition-all hover:shadow-sm">
                <div class="mb-1 text-center text-xl">🖼️</div>
                <h3 class="text-sm font-bold mb-1 text-center text-cyan-700">{t.corp}</h3>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed text-center">{t.corpCont}</p>
            </div>
            <div class="rounded-xl bg-purple-50/60 p-4 border border-purple-100 transition-all hover:shadow-sm">
                <div class="mb-1 text-center text-xl">🌊</div>
                <h3 class="text-sm font-bold mb-1 text-center text-purple-700">{t.add}</h3>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed text-center">{t.addCont}</p>
            </div>
            <div class="rounded-xl bg-orange-50/60 p-4 border border-orange-100 transition-all hover:shadow-sm">
                <div class="mb-1 text-center text-xl">🎯</div>
                <h3 class="text-sm font-bold mb-1 text-center text-orange-600">{t.annotate}</h3>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed text-center">{t.annotateCont}</p>
            </div>
        </div>
    </section>

    <!-- 隐私保护 -->
    <Privacy />

    <!-- 技术支持声明 -->
    <section class="text-center text-xs text-slate-400 [&_a]:underline py-3">
        Image Editor powered by <a href="https://github.com/scaleflex/filerobot-image-editor" target="_blank" rel="noopener noreferrer">Filerobot Image Editor</a>
    </section>

    <!-- 友情链接 / 更多工具 -->
    <div class="container mx-auto p-4 border-t border-slate-100 mt-4">
        <h3 class="text-center font-semibold p-2 mb-2 text-xs text-slate-500 uppercase tracking-wider">More Tools</h3>
        <div class="flex flex-row gap-6 justify-center">
            <div class="text-center">
                <a href="https://fakeact.fun/" target="_blank" title="fakeact.fun" class="inline-block text-xs p-2 rounded-md hover:bg-slate-100 transition-colors">
                    <img src={fakeact.src} alt="Fakeact logo" class="mx-auto mb-2 w-8" />
                    <p class="text-slate-600">Fakeact</p>
                </a>
            </div>
            <div class="text-center">
                <a href="https://mail.fakeact.fun/" target="_blank" title="mail.fakeact.fun" class="inline-block text-xs p-2 rounded-md hover:bg-slate-100 transition-colors">
                    <img src={fakemail.src} alt="FakeMail logo" class="mx-auto mb-2 w-8" />
                    <p class="text-slate-600">FakeMail</p>
                </a>
            </div>
        </div>
    </div>
</div>

<script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": l.title,
    "description": l.description,
    "operatingSystem": "ALL",
    "applicationCategory": "BrowserApplication",
    "browserRequirements": "requires HTML5 support",
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.6",
        "ratingCount": "2948",
        "bestRating": "5"
    },
    "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
    }
})}/>

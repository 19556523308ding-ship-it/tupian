---
import {getLang, getLocale} from '@i18n/index';
import { getRelativeLocaleUrl } from '@lib/localePaths';
const { locale } = Astro.params;
const l = getLang(locale);
const lang = getLocale(locale);
const t = l.editor;
const videoUrl = getRelativeLocaleUrl(lang, '/video-convert');
const isDefaultOrUpdated = lang === 'zh-CN' || lang === 'en';
const heroTitle = isDefaultOrUpdated ? t.feature : (l.nav?.videoConvert?.title || t.feature);
const heroCtaText = isDefaultOrUpdated ? t.extension : (l.nav?.videoConvert?.title || t.extension);
---

<div class="container py-8 relative z-10 flex-1">
    <!-- Hero 区：视频转 GIF -->
    <div class="text-center pt-6 pb-4">
        <h1 class="text-4xl sm:text-5xl text-center leading-[1.2] font-extrabold mb-3 bg-gradient-to-r from-indigo-600 via-purple-600 to-violet-500 bg-clip-text text-transparent">{heroTitle}</h1>
        <p class="text-center text-gray-500 text-base sm:text-lg max-w-2xl mx-auto">
            <span>{t.noSign}</span><span>{t.online} </span><span class="font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">{t.free} ✨</span>
        </p>
    </div>

    <!-- 主 CTA -->
    <div class="flex flex-col items-center gap-3 justify-center pt-4 pb-6">
        <a
            href={videoUrl}
            title={heroCtaText}
            class="group py-3.5 px-8 flex gap-2 items-center rounded-full text-base font-semibold text-white bg-gradient-to-r from-indigo-600 to-purple-600 shadow-brand hover:shadow-brand-lg hover:scale-[1.03] transition-all select-none"
        >
            <span>🎬</span>
            <span>{heroCtaText}</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <p class="text-xs opacity-70 text-center max-w-md">{t.capture}</p>
        <p class="text-xs opacity-70">{t.instantly}</p>
    </div>

    <!-- 工具入口 -->
    <div class="flex flex-col gap-3 justify-center text-xs md:flex-row md:flex-wrap [&_a]:py-2 [&_a]:px-4 [&_a]:inline-block [&_a]:rounded-full [&_a]:bg-white [&_a]:text-indigo-600 [&_a]:border [&_a]:border-indigo-200 [&_a]:shadow-sm [&_a]:transition-all hover:[&_a]:bg-gradient-to-r hover:[&_a]:from-indigo-600 hover:[&_a]:to-purple-600 hover:[&_a]:text-white hover:[&_a]:border-transparent hover:[&_a]:shadow-brand">
        <div class="text-center"><a href={getRelativeLocaleUrl(lang, '/video-convert')} title={l.nav.videoConvert.title}>🎬 {l.nav.videoConvert.title}</a></div>
        <div class="text-center"><a href={getRelativeLocaleUrl(lang, '/take-a-screenshot')} title={l.nav.screenshot.title}>📸 {l.nav.screenshot.title}</a></div>
        <div class="text-center"><a href={getRelativeLocaleUrl(lang, '/screenshot-beautifier')} title={l.nav.beautifier.title}>🏞️ {l.nav.beautifier.title}</a></div>
        <div class="text-center"><a href={getRelativeLocaleUrl(lang, '/image-compressor')} title={l.nav.compressor.title}>⬇️ {l.nav.compressor.title}</a></div>
        <div class="text-center"><a href={getRelativeLocaleUrl(lang, '/convert')} title={l.nav.convert.title}>🔁 {l.nav.convert.title}</a></div>
        <div class="text-center"><a href={getRelativeLocaleUrl(lang, '/long-image')} title={l.nav.longImage.title}>🧩 {l.nav.longImage.title}</a></div>
    </div>

    <!-- 特性说明 -->
    <section class="pt-12 pb-8">
        <h2 class="text-xl font-extrabold mb-4 text-center">{t.how}</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 mb-4">
            <div class="rounded-xl bg-indigo-50/60 p-5 border border-indigo-100 transition-all hover:shadow-md">
                <div class="mb-2 text-2xl text-center">🔒</div>
                <h3 class="text-sm font-bold mb-1 text-center text-indigo-700">{t.take}</h3>
                <p class="text-xs text-slate-500 mt-1 text-center">{t.use}</p>
            </div>
            <div class="rounded-xl bg-violet-50/60 p-5 border border-violet-100 transition-all hover:shadow-md">
                <div class="mb-2 text-2xl text-center">⚡</div>
                <h3 class="text-sm font-bold mb-1 text-center text-violet-700">{t.more}</h3>
                <p class="text-xs text-slate-500 mt-1 text-center">{t.moreUse}</p>
            </div>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3 mb-4">
            <div class="rounded-xl bg-cyan-50/60 p-5 border border-cyan-100 transition-all hover:shadow-md">
                <div class="mb-2 text-2xl text-center">🎯</div>
                <h3 class="text-sm font-bold mb-1 text-center text-cyan-700">{t.corp}</h3>
                <p class="text-xs text-slate-500 mt-1 text-center">{t.corpCont}</p>
            </div>
            <div class="rounded-xl bg-purple-50/60 p-5 border border-purple-100 transition-all hover:shadow-md">
                <div class="mb-2 text-2xl text-center">💎</div>
                <h3 class="text-sm font-bold mb-1 text-center text-purple-700">{t.add}</h3>
                <p class="text-xs text-slate-500 mt-1 text-center">{t.addCont}</p>
            </div>
            <div class="rounded-xl bg-orange-50/60 p-5 border border-orange-100 transition-all hover:shadow-md">
                <div class="mb-2 text-2xl text-center">🎨</div>
                <h3 class="text-sm font-bold mb-1 text-center text-orange-600">{t.annotate}</h3>
                <p class="text-xs text-slate-500 mt-1 text-center">{t.annotateCont}</p>
            </div>
        </div>
    </section>
</div>
<script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": l.title,
    "description": l.description,
    "operatingSystem": "ALL",
    "applicationCategory": "MultimediaApplication",
    "browserRequirements": "requires HTML5 support",
    "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
    }
})}/>
